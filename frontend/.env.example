# Copy to .env.local. Only NEXT_PUBLIC_ values belong here: they are shipped to the browser.
# Never put SerpApi, Nessie, Muse or Supabase secret keys in this file.

# FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Supabase Auth (Settings → API Keys). Leave blank to run on demo data without login.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # sb_publishable_...
