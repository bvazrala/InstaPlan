# Copy to .env. Never commit .env. Every key here stays on the server.

APP_ENV=dev
FRONTEND_ORIGIN=http://localhost:3000

# Local default is SQLite. For Supabase Postgres (Project Settings → Database → connection string):
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT:PASSWORD@HOST:5432/postgres
DATABASE_URL=sqlite:///./instaplan.db

# Supabase Auth (Project Settings → API)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # only used by scripts/seed_demo.py

# Encrypts private answers at rest. Generate one:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PRIVATE_DATA_KEY=

# Meta Muse Spark (group assistant). Confirm base URL and model id at the Meta booth.
MUSE_API_KEY=
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.1

# Gemini (private check-ins). Use a billing-enabled project so prompts aren't used for training.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

SERPAPI_KEY=

# Capital One Nessie sandbox. If calls fail, try https://prod-api.nessieisreal.com
NESSIE_API_KEY=
NESSIE_BASE_URL=http://api.nessieisreal.com
