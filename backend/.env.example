# Copy to .env. Never commit .env. Every key here stays on the server.

APP_ENV=dev
FRONTEND_ORIGIN=http://localhost:3000

# Local default is SQLite. For Supabase: Connect → Session pooler → copy the URI, put in your password,
# and change "postgresql://" to "postgresql+psycopg://"
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./instaplan.db

# Supabase Auth (Settings → API Keys)
SUPABASE_URL=                 # https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=     # sb_publishable_...
SUPABASE_SECRET_KEY=          # sb_secret_...  only used by scripts/seed_demo.py

# Encrypts private answers at rest. Generate one:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PRIVATE_DATA_KEY=

# Meta Muse Spark: group assistant and private check-ins.
# Standard models only. "-contributor" models may train on prompts; the backend refuses them.
MUSE_API_KEY=
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3

SERPAPI_KEY=

# Capital One Nessie sandbox. If calls fail, try https://prod-api.nessieisreal.com
NESSIE_API_KEY=
NESSIE_BASE_URL=http://api.nessieisreal.com
